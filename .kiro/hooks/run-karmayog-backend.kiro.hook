{
  "enabled": true,
  "name": "Run KarmayogAI Backend",
  "description": "Manually start the KarmayogAI Flask backend server using system Python on port 5001",
  "version": "1",
  "when": {
    "type": "userTriggered"
  },
  "then": {
    "type": "runCommand",
